+static void fortinet_legacy_tunnel_headers(struct openconnect_info *vpninfo,
+						   struct oc_text_buf *buf)
+{
+	struct oc_vpn_option *opt;
+
+	/* Some hosted FortiGate gateways require the legacy openfortivpn
+	 * tunnel request, including its literal virtual host name. */
+	buf_append(buf, "Host: sslvpn\r\n");
+	buf_append(buf, "User-Agent: Mozilla/5.0 SV1\r\n");
+	if (vpninfo->cookies) {
+		buf_append(buf, "Cookie: ");
+		for (opt = vpninfo->cookies; opt; opt = opt->next)
+			buf_append(buf, "%s=%s%s", opt->option, opt->value,
+				   opt->next ? "; " : "\r\n");
+	}
+}
