---
import {
  Activity,
  ArrowRight,
  BellRing,
  Check,
  CircleCheck,
  Download,
  ExternalLink,
  FileInput,
  FilePenLine,
  Globe,
  Layers,
  LockKeyhole,
  Menu,
  Monitor,
  Moon,
  Network,
  Plus,
  RefreshCw,
  Search,
  Settings2,
  ShieldCheck,
  Sparkles,
  SquareTerminal,
  X,
  Zap
} from "@lucide/astro";
import { Icon as BrandIcon } from "astro-icon/components";
import "../styles/global.css";
import Downloads from "../components/Downloads.astro";
import { release, repoUrl } from "../data/release";
import memory from "../data/memory.json";

const releaseUrl = release.html_url;
const version = release.tag_name.replace(/^v/, "");
const mib = (value: number) => value.toLocaleString("pt-BR", { maximumFractionDigits: 1, minimumFractionDigits: 1 });
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="TunnelYard reúne suas conexões FortiGate SSL VPN em um app desktop simples, nativo e open source para Linux, macOS e Windows."
    />
    <meta name="theme-color" content="#090a0c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="TunnelYard — todas as suas VPNs em um só lugar" />
    <meta
      property="og:description"
      content="Conecte múltiplos túneis, organize perfis e acompanhe tudo sem depender do terminal."
    />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <title>TunnelYard — VPN corporativa sem complicação</title>
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <div class="page-noise" aria-hidden="true"></div>
    <header class="site-header" data-header>
      <div class="container header-inner">
        <a class="brand" href="#inicio" aria-label="TunnelYard — início">
          <img src="/icon.svg" alt="" width="36" height="36" />
          <span>TunnelYard</span>
        </a>

        <nav class="desktop-nav" aria-label="Navegação principal">
          <a href="#produto">Produto</a>
          <a href="#recursos">Recursos</a>
          <a href="#seguranca">Segurança</a>
          <a href="#downloads">Downloads</a>
        </nav>

        <div class="header-actions">
          <a class="github-link" href={repoUrl} target="_blank" rel="noreferrer">
            <BrandIcon name="simple-icons:github" size={18} aria-hidden="true" />
            <span>GitHub</span>
          </a>
          <a class="button button-small button-primary" href="#downloads">
            Baixar
            <Download size={16} aria-hidden="true" />
          </a>
        </div>

        <button class="menu-button" type="button" aria-label="Abrir menu" aria-expanded="false" data-menu-button>
          <Menu class="menu-open-icon" size={22} aria-hidden="true" />
          <X class="menu-close-icon" size={22} aria-hidden="true" />
        </button>
      </div>

      <nav class="mobile-nav" aria-label="Navegação móvel" data-mobile-nav>
        <a href="#produto">Produto</a>
        <a href="#recursos">Recursos</a>
        <a href="#seguranca">Segurança</a>
        <a href="#downloads">Downloads</a>
        <a href={repoUrl} target="_blank" rel="noreferrer">Ver no GitHub</a>
      </nav>
    </header>

    <main>
      <section class="hero section" id="inicio">
        <div class="hero-glow hero-glow-one" aria-hidden="true"></div>
        <div class="hero-glow hero-glow-two" aria-hidden="true"></div>
        <div class="container hero-grid">
          <div class="hero-copy">
            <div class="eyebrow reveal">
              <span class="eyebrow-dot"></span>
              <BrandIcon name="simple-icons:rust" size={14} aria-hidden="true" />
              Open source · feito em Rust
            </div>
            <h1 class="reveal reveal-delay-1">
              Suas VPNs.<br />
              Um só lugar.<br />
              <span>Zero terminais.</span>
            </h1>
            <p class="hero-lead reveal reveal-delay-2">
              Conecte múltiplos ambientes FortiGate, organize seus perfis e saiba
              exatamente o que está acontecendo — sem decorar comandos ou editar
              arquivos na mão.
            </p>
            <div class="hero-actions reveal reveal-delay-3">
              <a
                class="button button-primary button-large"
                href="#downloads"
                data-primary-download
              >
                <Download size={19} aria-hidden="true" />
                <span data-download-label>Baixar v{version}</span>
              </a>
              <a class="button button-secondary button-large" href="#produto">
                Ver como funciona
                <ArrowRight size={18} aria-hidden="true" />
              </a>
            </div>
            <div class="hero-meta reveal reveal-delay-4">
              <span><Check size={15} /> Gratuito e open source</span>
              <span><Check size={15} /> Linux, macOS e Windows</span>
            </div>
          </div>

          <div class="hero-product reveal reveal-delay-2" aria-label="Prévia da interface do TunnelYard">
            <div class="orbit orbit-one" aria-hidden="true"><span></span></div>
            <div class="orbit orbit-two" aria-hidden="true"><span></span></div>
            <div class="app-window">
              <div class="app-titlebar">
                <div class="window-controls" aria-hidden="true">
                  <span></span><span></span><span></span>
                </div>
                <div class="app-title">
                  <img src="/icon.svg" alt="" width="20" height="20" />
                  <span>TunnelYard</span>
                </div>
                <div class="titlebar-actions">
                  <Moon size={13} aria-hidden="true" />
                  <span>—</span>
                  <span>×</span>
                </div>
              </div>

              <div class="app-layout">
                <aside class="app-sidebar">
                  <div class="side-brand">
                    <div>
                      <strong>TunnelYard</strong>
                      <small>Control desk</small>
                    </div>
                    <span class="version-pill">v{version}</span>
                  </div>

                  <div class="connection-summary">
                    <div class="summary-icon"><Activity size={16} aria-hidden="true" /></div>
                    <div><strong>2 conexões</strong><small>todas estáveis</small></div>
                    <span class="live-indicator"></span>
                  </div>

                  <button class="mock-primary" type="button">
                    <Plus size={14} aria-hidden="true" />
                    Novo perfil
                  </button>
                  <div class="side-links">
                    <span><FileInput size={14} /> Importar .conf</span>
                    <span><Settings2 size={14} /> Preferências</span>
                  </div>
                  <div class="side-spacer"></div>
                  <div class="side-security">
                    <ShieldCheck size={15} aria-hidden="true" />
                    <div><strong>Execução protegida</strong><small>Interface sem privilégios</small></div>
                  </div>
                </aside>

                <div class="app-main">
                  <div class="app-heading">
                    <div><h2>Seus túneis</h2><p>Gerencie todos os ambientes daqui.</p></div>
                    <div class="mock-search"><Search size={13} aria-hidden="true" /><span>Buscar perfil...</span></div>
                  </div>

                  <div class="profile-list">
                    <article class="profile-card profile-connected">
                      <div class="profile-mark mark-coral">HQ</div>
                      <div class="profile-info">
                        <div class="profile-name">
                          <strong>Acme HQ</strong>
                          <span class="status-badge connected"><i></i> Conectado</span>
                        </div>
                        <p>vpn.acme.com · 10443</p>
                        <div class="profile-stats"><span>12m 48s</span><span>↓ 28.4 MB</span><span>↑ 4.1 MB</span></div>
                      </div>
                      <button class="profile-action disconnect" type="button">Desconectar</button>
                    </article>

                    <article class="profile-card profile-connected">
                      <div class="profile-mark mark-violet">NX</div>
                      <div class="profile-info">
                        <div class="profile-name">
                          <strong>Cliente North</strong>
                          <span class="status-badge connected"><i></i> Conectado</span>
                        </div>
                        <p>ssl.north.dev · 443</p>
                        <div class="profile-stats"><span>04m 22s</span><span>↓ 8.6 MB</span><span>↑ 1.2 MB</span></div>
                      </div>
                      <button class="profile-action disconnect" type="button">Desconectar</button>
                    </article>

                    <article class="profile-card">
                      <div class="profile-mark mark-blue">ST</div>
                      <div class="profile-info">
                        <div class="profile-name">
                          <strong>Staging</strong>
                          <span class="status-badge idle"><i></i> Inativo</span>
                        </div>
                        <p>vpn.staging.internal · 443</p>
                        <div class="profile-stats"><span>Último acesso ontem</span></div>
                      </div>
                      <button class="profile-action connect" type="button">Conectar</button>
                    </article>
                  </div>

                  <div class="console-panel">
                    <div class="console-top">
                      <span><SquareTerminal size={12} /> Console ao vivo</span>
                      <span class="console-live"><i></i> recebendo</span>
                    </div>
                    <div class="console-lines">
                      <p><span>20:41:08</span> Tunnel is up and running.</p>
                      <p><span>20:41:08</span> Routes and DNS configured.</p>
                      <p class="console-accent"><span>20:41:09</span> ✓ Connected to Acme HQ</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="floating-toast toast-connected">
              <span class="toast-icon"><CircleCheck size={18} /></span>
              <div><strong>VPN conectada</strong><small>Acme HQ está pronta.</small></div>
            </div>

            <div class="floating-toast toast-recovery">
              <span class="toast-icon"><RefreshCw size={16} /></span>
              <div><strong>Reconexão automática</strong><small>Você nem precisou intervir.</small></div>
            </div>
          </div>
        </div>

        <div class="container trusted-row reveal">
          <span>Compatível com</span>
          <div class="trusted-platforms">
            <span><BrandIcon name="simple-icons:linux" size={17} /> Linux</span>
            <span><BrandIcon name="simple-icons:apple" size={17} /> macOS</span>
            <span><BrandIcon name="simple-icons:windows" size={17} /> Windows</span>
            <span class="trusted-divider"></span>
            <span>FortiGate SSL VPN</span>
          </div>
        </div>
      </section>

      <section class="problem section" id="produto">
        <div class="container">
          <div class="section-heading centered reveal">
            <div class="eyebrow"><Sparkles size={14} aria-hidden="true" /> Menos atrito, mais trabalho feito</div>
            <h2>Você só queria acessar o ambiente.<br /><span>Não virar especialista em terminal.</span></h2>
            <p>TunnelYard transforma uma rotina frágil e repetitiva em um fluxo visual, previsível e fácil de acompanhar.</p>
          </div>

          <div class="before-after">
            <article class="pain-card reveal">
              <div class="comparison-label pain-label"><span></span> Antes</div>
              <div class="terminal-window">
                <div class="terminal-title">
                  <div><i></i><i></i><i></i></div>
                  <span>Terminal — bash</span>
                </div>
                <div class="terminal-body">
                  <p><span class="terminal-user">$</span> sudo openfortivpn cliente.conf</p>
                  <p class="terminal-muted">INFO: Connected to gateway.</p>
                  <p class="terminal-muted">INFO: Authentication succeeded.</p>
                  <p class="terminal-error">ERROR: pppd: The link was terminated.</p>
                  <p><span class="terminal-user">$</span> sudo openfortivpn cliente.conf</p>
                  <p class="terminal-cursor">_</p>
                </div>
              </div>
              <ul>
                <li><X size={16} /> Comandos e permissões toda vez</li>
                <li><X size={16} /> Vários terminais para vários clientes</li>
                <li><X size={16} /> Descobrir quedas tarde demais</li>
              </ul>
            </article>

            <div class="comparison-arrow reveal reveal-delay-1" aria-hidden="true"><ArrowRight size={20} /></div>

            <article class="solution-card reveal reveal-delay-2">
              <div class="comparison-label solution-label"><span></span> Com TunnelYard</div>
              <div class="mini-dashboard">
                <div class="mini-top">
                  <div><span class="mini-avatar">AC</span><div><strong>Acme HQ</strong><small>vpn.acme.com</small></div></div>
                  <span class="status-badge connected"><i></i> Conectado</span>
                </div>
                <div class="connection-journey" aria-label="Gateway autenticado, rotas aplicadas e túnel pronto">
                  <div class="journey-progress" aria-hidden="true"><i></i></div>
                  <div class="journey-step journey-auth">
                    <span><LockKeyhole size={14} /></span>
                    <div><strong>Autenticar</strong><small>Gateway aceitou</small></div>
                  </div>
                  <div class="journey-step journey-routes">
                    <span><Network size={14} /></span>
                    <div><strong>Configurar</strong><small>Rotas e DNS</small></div>
                  </div>
                  <div class="journey-step journey-ready">
                    <span><Check size={14} /></span>
                    <div><strong>Trabalhar</strong><small>Túnel pronto</small></div>
                  </div>
                </div>
                <div class="mini-stats">
                  <div><small>Status</small><strong>Estável</strong></div>
                  <div><small>Tempo</small><strong>12m 48s</strong></div>
                  <div><small>Túneis</small><strong>2 ativos</strong></div>
                </div>
              </div>
              <ul>
                <li><Check size={16} /> Um clique para conectar</li>
                <li><Check size={16} /> Múltiplos túneis lado a lado</li>
                <li><Check size={16} /> Alertas e reconexão automática</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section class="features section" id="recursos">
        <div class="container">
          <div class="section-heading split-heading reveal">
            <div>
              <div class="eyebrow"><Zap size={14} aria-hidden="true" /> Tudo sob controle</div>
              <h2>Feito para quem vive<br />entre ambientes.</h2>
            </div>
            <p>De um único cliente a uma coleção inteira de acessos: o TunnelYard deixa o trabalho operacional pequeno, claro e confiável.</p>
          </div>

          <div class="bento-grid">
            <article class="feature-card feature-large feature-multi reveal">
              <div class="feature-icon"><Layers size={22} /></div>
              <div class="feature-copy">
                <span class="feature-kicker">Multi-túnel</span>
                <h3>Todos os clientes.<br />Todos ao mesmo tempo.</h3>
                <p>Abra conexões independentes em paralelo e veja o estado de cada ambiente sem alternar entre janelas.</p>
              </div>
              <div class="tunnel-visual" aria-hidden="true">
                <div class="tunnel-control">
                  <img src="/icon.svg" alt="" width="42" height="42" />
                  <div><strong>TunnelYard</strong><small>3 túneis simultâneos</small></div>
                  <span class="control-count"><i></i><i></i><i></i> 3/3</span>
                  <i class="hub-port port-one"></i>
                  <i class="hub-port port-two"></i>
                  <i class="hub-port port-three"></i>
                </div>
                <div class="tunnel-lanes">
                  <div class="tunnel-lane lane-one">
                    <span class="lane-wire"><i></i></span>
                    <div class="tunnel-endpoint endpoint-hq"><span>HQ</span><div><strong>Acme HQ</strong><small>42 ms</small></div><i></i></div>
                  </div>
                  <div class="tunnel-lane lane-two">
                    <span class="lane-wire"><i></i></span>
                    <div class="tunnel-endpoint endpoint-nx"><span>NX</span><div><strong>North</strong><small>68 ms</small></div><i></i></div>
                  </div>
                  <div class="tunnel-lane lane-three">
                    <span class="lane-wire"><i></i></span>
                    <div class="tunnel-endpoint endpoint-st"><span>ST</span><div><strong>Staging</strong><small>31 ms</small></div><i></i></div>
                  </div>
                </div>
              </div>
            </article>

            <article class="feature-card feature-editor reveal reveal-delay-1">
              <div class="feature-icon"><FilePenLine size={21} /></div>
              <span class="feature-kicker">Perfis</span>
              <h3>Configuração visual, sem perder compatibilidade.</h3>
              <p>Crie, edite ou importe arquivos openfortivpn .conf.</p>
              <div class="editor-preview" aria-hidden="true">
                <div><span>Gateway</span><strong>vpn.acme.com</strong></div>
                <div><span>Porta</span><strong>10443</strong></div>
                <div class="editor-switch"><span>Reconectar</span><i></i></div>
              </div>
            </article>

            <article class="feature-card feature-alerts reveal">
              <div class="feature-icon"><BellRing size={21} /></div>
              <span class="feature-kicker">Visibilidade</span>
              <h3>Saiba quando conecta. E quando cai.</h3>
              <p>Notificações nativas e console ao vivo sem vigiar o terminal.</p>
              <div class="alert-stack" aria-hidden="true">
                <div><CircleCheck size={17} /><span><strong>Acme HQ conectada</strong><small>agora</small></span></div>
                <div><RefreshCw size={17} /><span><strong>Link recuperado</strong><small>há 2 min</small></span></div>
              </div>
            </article>

            <article class="feature-card feature-tray reveal reveal-delay-1">
              <div class="feature-icon"><Network size={21} /></div>
              <span class="feature-kicker">Segundo plano</span>
              <h3>Feche a janela.<br />O túnel continua.</h3>
              <p>Controle as conexões pela bandeja e inicie junto com o sistema.</p>
              <div class="tray-preview" aria-hidden="true">
                <div class="tray-bar"><span></span><span></span><span></span><div class="tray-icon"><img src="/icon.svg" alt="" /></div></div>
                <div class="tray-menu">
                  <strong>TunnelYard</strong>
                  <span><i></i> Acme HQ <small>Conectada</small></span>
                  <span><i></i> Cliente North <small>Conectada</small></span>
                </div>
              </div>
            </article>

            <article class="feature-card feature-language reveal">
              <div class="feature-icon"><Globe size={21} /></div>
              <span class="feature-kicker">Do seu jeito</span>
              <h3>Português, inglês, tema claro ou escuro.</h3>
              <p>A interface acompanha seu idioma e a aparência do sistema.</p>
              <div class="language-pills" aria-hidden="true"><span class="active">PT-BR</span><span>EN</span><i></i></div>
            </article>
          </div>
        </div>
      </section>

      <section class="security section" id="seguranca">
        <div class="security-glow" aria-hidden="true"></div>
        <div class="container security-grid">
          <div class="security-copy reveal">
            <div class="eyebrow eyebrow-dark"><LockKeyhole size={14} aria-hidden="true" /> Privilégio mínimo</div>
            <h2>A interface nunca precisa rodar como administrador.</h2>
            <p>O TunnelYard mantém a experiência visual separada das operações privilegiadas. Quando necessário, o próprio sistema operacional solicita sua autorização.</p>
            <a href={repoUrl + "#privacy-notes"} target="_blank" rel="noreferrer">
              Veja como funciona no código
              <ExternalLink size={15} />
            </a>
          </div>

          <div class="security-steps reveal reveal-delay-2">
            <div class="security-step">
              <span class="step-number">01</span>
              <div class="step-icon"><Monitor size={19} /></div>
              <div><strong>Você pede a conexão</strong><p>A interface prepara somente o perfil escolhido.</p></div>
            </div>
            <div class="step-connector"></div>
            <div class="security-step">
              <span class="step-number">02</span>
              <div class="step-icon"><ShieldCheck size={19} /></div>
              <div><strong>O sistema autoriza</strong><p>PolicyKit, prompt nativo do macOS ou UAC.</p></div>
            </div>
            <div class="step-connector"></div>
            <div class="security-step">
              <span class="step-number">03</span>
              <div class="step-icon"><LockKeyhole size={19} /></div>
              <div><strong>O túnel roda isolado</strong><p>Cada sessão possui seu próprio ciclo de vida.</p></div>
            </div>
          </div>
        </div>
      </section>

      <section class="performance section" id="performance" aria-labelledby="performance-title">
        <div class="container">
          <div class="section-heading centered reveal">
            <div class="eyebrow"><BrandIcon name="simple-icons:rust" size={16} /> Rust por dentro. Números à vista.</div>
            <h2 id="performance-title">Quanto de RAM, na prática?</h2>
            <p>Primeira coleta local: consumo observado em Linux, com o app aberto e com dois túneis conectados.</p>
          </div>
          <div class="memory-grid">
            <article class="memory-card reveal"><h3>Sem conexões</h3><strong class="memory-value">{mib(memory.groups.idle.mean)} MiB</strong><p>Processo gráfico recém-aberto, ocioso. Instância separada, sem túneis.</p></article>
            <article class="memory-card reveal"><h3>Com 2 túneis conectados</h3><strong class="memory-value">{mib(memory.groups.active.mean)} MiB</strong><p>Somente o processo gráfico já em uso. Tráfego de rede não controlado.</p></article>
            <article class="memory-card reveal"><h3>Motores dos 2 túneis</h3><strong class="memory-value">+{mib(memory.groups.engines.mean)} MiB</strong><p>Dois processos OpenFortiVPN e dois pppd, além da interface.</p></article>
          </div>
          <div class="measurement-note">
            <p><strong>Coleta exploratória · 08/09/2026.</strong> Ubuntu 26.04.1 LTS, x86_64, versão 2.6.0 (anterior ao rebranding), build de desenvolvimento. Média de 60 amostras de RSS, a cada segundo.</p>
            <p>As instâncias têm tempos de vida e estados gráficos diferentes: estes valores não são uma comparação controlada entre ocioso e conectado, nem um benchmark da 2.7.0. Excluem memória da GPU, kernel e serviços do desktop. A soma de RSS pode contar memória compartilhada mais de uma vez. O consumo varia por máquina e uso.</p>
            <details><summary>Ver método e intervalos medidos</summary><p>Leitura de VmRSS em /proc/PID/status, sem acessar credenciais. Ocioso: {mib(memory.groups.idle.min)}–{mib(memory.groups.idle.max)} MiB. Conectado: {mib(memory.groups.active.min)}–{mib(memory.groups.active.max)} MiB. Motores: {mib(memory.groups.engines.min)}–{mib(memory.groups.engines.max)} MiB. As conexões existentes foram preservadas.</p></details>
          </div>
        </div>
      </section>

      <section class="downloads section" id="downloads">
        <div class="container">
          <div class="section-heading centered reveal">
            <div class="eyebrow"><Download size={14} aria-hidden="true" /> Versão {version}</div>
            <h2>Pronto para o seu sistema.</h2>
            <p>Escolha a plataforma e comece. Sem conta, assinatura ou licença proprietária.</p>
          </div>

          <Downloads />

          <p class="download-note reveal">
            O macOS pode pedir uma confirmação na primeira abertura. No Windows ARM64,
            o cliente OpenConnect + Wintun nativo deve ser instalado separadamente.
            <a href={releaseUrl}>Ver todos os arquivos e instruções.</a>
          </p>
        </div>
      </section>

      <section class="final-cta section">
        <div class="container">
          <div class="cta-panel reveal">
            <div class="cta-grid" aria-hidden="true"></div>
            <div class="cta-orb cta-orb-one" aria-hidden="true"></div>
            <div class="cta-orb cta-orb-two" aria-hidden="true"></div>
            <img src="/icon.svg" alt="" width="72" height="72" class="cta-icon" />
            <div class="eyebrow eyebrow-light"><Sparkles size={14} /> Menos terminal. Mais fluxo.</div>
            <h2>Sua próxima conexão<br />pode levar um clique.</h2>
            <p>Baixe o TunnelYard, importe seus perfis e siga o trabalho.</p>
            <div class="cta-actions">
              <a class="button button-white button-large" href="#downloads"><Download size={19} /> Baixar v{version}</a>
              <a class="button button-ghost-light button-large" href={repoUrl} target="_blank" rel="noreferrer"><BrandIcon name="simple-icons:github" size={19} /> Ver no GitHub</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <div class="footer-brand">
          <a class="brand" href="#inicio"><img src="/icon.svg" alt="" width="34" height="34" /><span>TunnelYard</span></a>
          <p>FortiGate SSL VPN, sem a parte complicada.</p>
        </div>
        <div class="footer-links">
          <a href={repoUrl} target="_blank" rel="noreferrer">GitHub</a>
          <a href={releaseUrl}>Releases</a>
          <a href={repoUrl + "/blob/master/LICENSE"} target="_blank" rel="noreferrer">Licença MIT</a>
          <a href={repoUrl + "/issues"} target="_blank" rel="noreferrer">Issues</a>
        </div>
        <p class="footer-meta">Open source · Feito com Rust e cuidado.</p>
      </div>
    </footer>

    <script>
      const header = document.querySelector<HTMLElement>("[data-header]");
      const menuButton = document.querySelector<HTMLButtonElement>("[data-menu-button]");
      const mobileNav = document.querySelector<HTMLElement>("[data-mobile-nav]");

      const closeMenu = () => {
        menuButton?.setAttribute("aria-expanded", "false");
        header?.classList.remove("menu-is-open");
      };

      menuButton?.addEventListener("click", () => {
        const nextState = menuButton.getAttribute("aria-expanded") !== "true";
        menuButton.setAttribute("aria-expanded", String(nextState));
        header?.classList.toggle("menu-is-open", nextState);
      });

      mobileNav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));

      const updateHeader = () => header?.classList.toggle("is-scrolled", window.scrollY > 18);
      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });

      const download = document.querySelector<HTMLAnchorElement>("[data-primary-download]");
      const downloadLabel = document.querySelector<HTMLElement>("[data-download-label]");
      const userAgent = navigator.userAgent.toLowerCase();

      if (download && downloadLabel) {
        if (userAgent.includes("mac")) {
          download.href = "#download-macos";
          downloadLabel.textContent = "Baixar para macOS";
        } else if (userAgent.includes("win")) {
          download.href = "#download-windows";
          downloadLabel.textContent = "Baixar para Windows";
        } else if (userAgent.includes("linux")) {
          download.href = "#download-linux";
          downloadLabel.textContent = "Baixar para Linux";
        }
      }

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const revealItems = document.querySelectorAll<HTMLElement>(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -48px" }
        );
        revealItems.forEach((item) => observer.observe(item));
      }

      const hero = document.querySelector<HTMLElement>(".hero");
      hero?.addEventListener("pointermove", (event) => {
        if (reduceMotion) return;
        const bounds = hero.getBoundingClientRect();
        hero.style.setProperty("--pointer-x", String(event.clientX - bounds.left) + "px");
        hero.style.setProperty("--pointer-y", String(event.clientY - bounds.top) + "px");
      });
    </script>
  </body>
</html>
