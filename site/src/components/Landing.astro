---
import {
  Activity,
  ArrowRight,
  BellRing,
  Check,
  CircleCheck,
  Download,
  ExternalLink,
  FileInput,
  FilePenLine,
  Globe,
  Layers,
  LockKeyhole,
  Menu,
  Monitor,
  Moon,
  Network,
  Plus,
  RefreshCw,
  Search,
  Settings2,
  ShieldCheck,
  Sparkles,
  SquareTerminal,
  X,
  Zap
} from "@lucide/astro";
import { Icon as BrandIcon } from "astro-icon/components";
import "../styles/global.css";
import Downloads from "./Downloads.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import MemoryLab from "./MemoryLab.astro";
import { release, repoUrl } from "../data/release";
import { dictionaries, fill, localePath, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionaries[locale];

const releaseUrl = release.html_url;
const version = release.tag_name.replace(/^v/, "");

const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(localePath(locale));
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#090a0c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.ogTitle} />
    <meta property="og:description" content={t.meta.ogDescription} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={absolute(localePath("en"))} />
    <link rel="alternate" hreflang="pt-BR" href={absolute(localePath("pt-BR"))} />
    <link rel="alternate" hreflang="x-default" href={absolute(localePath("en"))} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <title>{t.meta.title}</title>
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <div class="page-noise" aria-hidden="true"></div>
    <header class="site-header" data-header>
      <div class="container header-inner">
        <a class="brand" href="#inicio" aria-label={t.nav.brand}>
          <img src="/icon.svg" alt="" width="36" height="36" />
          <span>TunnelYard</span>
        </a>

        <nav class="desktop-nav" aria-label={t.nav.main}>
          <a href="#produto">{t.nav.product}</a>
          <a href="#recursos">{t.nav.features}</a>
          <a href="#seguranca">{t.nav.security}</a>
          <a href="#performance">{t.nav.performance}</a>
          <a href="#downloads">{t.nav.downloads}</a>
        </nav>

        <div class="header-actions">
          <LanguageSwitcher locale={locale} t={t} />
          <a class="github-link" href={repoUrl} target="_blank" rel="noreferrer">
            <BrandIcon name="simple-icons:github" size={18} aria-hidden="true" />
            <span>{t.nav.github}</span>
          </a>
          <a class="button button-small button-primary" href="#downloads">
            {t.nav.download}
            <Download size={16} aria-hidden="true" />
          </a>
        </div>

        <button class="menu-button" type="button" aria-label={t.nav.openMenu} aria-expanded="false" data-menu-button>
          <Menu class="menu-open-icon" size={22} aria-hidden="true" />
          <X class="menu-close-icon" size={22} aria-hidden="true" />
        </button>
      </div>

      <nav class="mobile-nav" aria-label={t.nav.mobile} data-mobile-nav>
        <a href="#produto">{t.nav.product}</a>
        <a href="#recursos">{t.nav.features}</a>
        <a href="#seguranca">{t.nav.security}</a>
        <a href="#performance">{t.nav.performance}</a>
        <a href="#downloads">{t.nav.downloads}</a>
        <a href={repoUrl} target="_blank" rel="noreferrer">{t.nav.viewOnGithub}</a>
        <LanguageSwitcher locale={locale} t={t} />
      </nav>
    </header>

    <main>
      <section class="hero section" id="inicio">
        <div class="hero-glow hero-glow-one" aria-hidden="true"></div>
        <div class="hero-glow hero-glow-two" aria-hidden="true"></div>
        <div class="container hero-grid">
          <div class="hero-copy">
            <div class="eyebrow reveal">
              <span class="eyebrow-dot"></span>
              <BrandIcon name="simple-icons:rust" size={14} aria-hidden="true" />
              {t.hero.eyebrow}
            </div>
            <h1 class="reveal reveal-delay-1">
              {t.hero.titleLine1}<br />
              {t.hero.titleLine2}<br />
              <span>{t.hero.titleLine3}</span>
            </h1>
            <p class="hero-lead reveal reveal-delay-2">{t.hero.lead}</p>
            <div class="hero-actions reveal reveal-delay-3">
              <a
                class="button button-primary button-large"
                href="#downloads"
                data-primary-download
                data-label-mac={t.hero.ctaDownloadMac}
                data-label-windows={t.hero.ctaDownloadWindows}
                data-label-linux={t.hero.ctaDownloadLinux}
              >
                <Download size={19} aria-hidden="true" />
                <span data-download-label>{fill(t.hero.ctaDownload, { version })}</span>
              </a>
              <a class="button button-secondary button-large" href="#produto">
                {t.hero.ctaHow}
                <ArrowRight size={18} aria-hidden="true" />
              </a>
            </div>
            <div class="hero-meta reveal reveal-delay-4">
              <span><Check size={15} /> {t.hero.metaFree}</span>
              <span><Check size={15} /> {t.hero.metaPlatforms}</span>
            </div>
          </div>

          <div class="hero-product reveal reveal-delay-2" aria-label={t.hero.previewLabel}>
            <div class="orbit orbit-one" aria-hidden="true"><span></span></div>
            <div class="orbit orbit-two" aria-hidden="true"><span></span></div>
            <div class="app-window">
              <div class="app-titlebar">
                <div class="window-controls" aria-hidden="true">
                  <span></span><span></span><span></span>
                </div>
                <div class="app-title">
                  <img src="/icon.svg" alt="" width="20" height="20" />
                  <span>TunnelYard</span>
                </div>
                <div class="titlebar-actions">
                  <Moon size={13} aria-hidden="true" />
                  <span>—</span>
                  <span>×</span>
                </div>
              </div>

              <div class="app-layout">
                <aside class="app-sidebar">
                  <div class="side-brand">
                    <div>
                      <strong>TunnelYard</strong>
                      <small>{t.hero.app.controlDesk}</small>
                    </div>
                    <span class="version-pill">v{version}</span>
                  </div>

                  <div class="connection-summary">
                    <div class="summary-icon"><Activity size={16} aria-hidden="true" /></div>
                    <div><strong>{t.hero.app.connections}</strong><small>{t.hero.app.allStable}</small></div>
                    <span class="live-indicator"></span>
                  </div>

                  <button class="mock-primary" type="button">
                    <Plus size={14} aria-hidden="true" />
                    {t.hero.app.newProfile}
                  </button>
                  <div class="side-links">
                    <span><FileInput size={14} /> {t.hero.app.importConf}</span>
                    <span><Settings2 size={14} /> {t.hero.app.preferences}</span>
                  </div>
                  <div class="side-spacer"></div>
                  <div class="side-security">
                    <ShieldCheck size={15} aria-hidden="true" />
                    <div><strong>{t.hero.app.protectedRun}</strong><small>{t.hero.app.unprivileged}</small></div>
                  </div>
                </aside>

                <div class="app-main">
                  <div class="app-heading">
                    <div><h2>{t.hero.app.yourTunnels}</h2><p>{t.hero.app.manageAll}</p></div>
                    <div class="mock-search"><Search size={13} aria-hidden="true" /><span>{t.hero.app.searchProfile}</span></div>
                  </div>

                  <div class="profile-list">
                    <article class="profile-card profile-connected">
                      <div class="profile-mark mark-coral">HQ</div>
                      <div class="profile-info">
                        <div class="profile-name">
                          <strong>Acme HQ</strong>
                          <span class="status-badge connected"><i></i> {t.hero.app.connected}</span>
                        </div>
                        <p>vpn.acme.com · 10443</p>
                        <div class="profile-stats"><span>12m 48s</span><span>↓ 28.4 MB</span><span>↑ 4.1 MB</span></div>
                      </div>
                      <button class="profile-action disconnect" type="button">{t.hero.app.disconnect}</button>
                    </article>

                    <article class="profile-card profile-connected">
                      <div class="profile-mark mark-violet">NX</div>
                      <div class="profile-info">
                        <div class="profile-name">
                          <strong>{t.hero.app.northClient}</strong>
                          <span class="status-badge connected"><i></i> {t.hero.app.connected}</span>
                        </div>
                        <p>ssl.north.dev · 443</p>
                        <div class="profile-stats"><span>04m 22s</span><span>↓ 8.6 MB</span><span>↑ 1.2 MB</span></div>
                      </div>
                      <button class="profile-action disconnect" type="button">{t.hero.app.disconnect}</button>
                    </article>

                    <article class="profile-card">
                      <div class="profile-mark mark-blue">ST</div>
                      <div class="profile-info">
                        <div class="profile-name">
                          <strong>{t.hero.app.staging}</strong>
                          <span class="status-badge idle"><i></i> {t.hero.app.idle}</span>
                        </div>
                        <p>vpn.staging.internal · 443</p>
                        <div class="profile-stats"><span>{t.hero.app.lastAccess}</span></div>
                      </div>
                      <button class="profile-action connect" type="button">{t.hero.app.connect}</button>
                    </article>
                  </div>

                  <div class="console-panel">
                    <div class="console-top">
                      <span><SquareTerminal size={12} /> {t.hero.app.liveConsole}</span>
                      <span class="console-live"><i></i> {t.hero.app.receiving}</span>
                    </div>
                    <div class="console-lines">
                      <p><span>20:41:08</span> {t.hero.app.logUp}</p>
                      <p><span>20:41:08</span> {t.hero.app.logRoutes}</p>
                      <p class="console-accent"><span>20:41:09</span> {t.hero.app.logConnected}</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="floating-toast toast-connected">
              <span class="toast-icon"><CircleCheck size={18} /></span>
              <div><strong>{t.hero.toastConnected}</strong><small>{t.hero.toastConnectedNote}</small></div>
            </div>

            <div class="floating-toast toast-recovery">
              <span class="toast-icon"><RefreshCw size={16} /></span>
              <div><strong>{t.hero.toastRecovery}</strong><small>{t.hero.toastRecoveryNote}</small></div>
            </div>
          </div>
        </div>

        <div class="container trusted-row reveal">
          <span>{t.hero.trustedWith}</span>
          <div class="trusted-platforms">
            <span><BrandIcon name="simple-icons:linux" size={17} /> Linux</span>
            <span><BrandIcon name="simple-icons:apple" size={17} /> macOS</span>
            <span><BrandIcon name="simple-icons:windows" size={17} /> Windows</span>
            <span class="trusted-divider"></span>
            <span>FortiGate SSL VPN</span>
          </div>
        </div>
      </section>

      <section class="problem section" id="produto">
        <div class="container">
          <div class="section-heading centered reveal">
            <div class="eyebrow"><Sparkles size={14} aria-hidden="true" /> {t.problem.eyebrow}</div>
            <h2>{t.problem.titleLine1}<br /><span>{t.problem.titleLine2}</span></h2>
            <p>{t.problem.lead}</p>
          </div>

          <div class="before-after">
            <article class="pain-card reveal">
              <div class="comparison-label pain-label"><span></span> {t.problem.beforeLabel}</div>
              <div class="terminal-window">
                <div class="terminal-title">
                  <div><i></i><i></i><i></i></div>
                  <span>{t.problem.terminalTitle}</span>
                </div>
                <div class="terminal-body">
                  <p><span class="terminal-user">$</span> sudo openfortivpn cliente.conf</p>
                  <p class="terminal-muted">{t.problem.terminalConnected}</p>
                  <p class="terminal-muted">{t.problem.terminalAuth}</p>
                  <p class="terminal-error">{t.problem.terminalError}</p>
                  <p><span class="terminal-user">$</span> sudo openfortivpn cliente.conf</p>
                  <p class="terminal-cursor">_</p>
                </div>
              </div>
              <ul>
                <li><X size={16} /> {t.problem.painOne}</li>
                <li><X size={16} /> {t.problem.painTwo}</li>
                <li><X size={16} /> {t.problem.painThree}</li>
              </ul>
            </article>

            <div class="comparison-arrow reveal reveal-delay-1" aria-hidden="true"><ArrowRight size={20} /></div>

            <article class="solution-card reveal reveal-delay-2">
              <div class="comparison-label solution-label"><span></span> {t.problem.afterLabel}</div>
              <div class="mini-dashboard">
                <div class="mini-top">
                  <div><span class="mini-avatar">AC</span><div><strong>Acme HQ</strong><small>vpn.acme.com</small></div></div>
                  <span class="status-badge connected"><i></i> {t.hero.app.connected}</span>
                </div>
                <div class="connection-journey" aria-label={t.problem.journeyLabel}>
                  <div class="journey-progress" aria-hidden="true"><i></i></div>
                  <div class="journey-step journey-auth">
                    <span><LockKeyhole size={14} /></span>
                    <div><strong>{t.problem.journeyAuth}</strong><small>{t.problem.journeyAuthNote}</small></div>
                  </div>
                  <div class="journey-step journey-routes">
                    <span><Network size={14} /></span>
                    <div><strong>{t.problem.journeyRoutes}</strong><small>{t.problem.journeyRoutesNote}</small></div>
                  </div>
                  <div class="journey-step journey-ready">
                    <span><Check size={14} /></span>
                    <div><strong>{t.problem.journeyReady}</strong><small>{t.problem.journeyReadyNote}</small></div>
                  </div>
                </div>
                <div class="mini-stats">
                  <div><small>{t.problem.statStatus}</small><strong>{t.problem.statStatusValue}</strong></div>
                  <div><small>{t.problem.statTime}</small><strong>12m 48s</strong></div>
                  <div><small>{t.problem.statTunnels}</small><strong>{t.problem.statTunnelsValue}</strong></div>
                </div>
              </div>
              <ul>
                <li><Check size={16} /> {t.problem.winOne}</li>
                <li><Check size={16} /> {t.problem.winTwo}</li>
                <li><Check size={16} /> {t.problem.winThree}</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section class="features section" id="recursos">
        <div class="container">
          <div class="section-heading split-heading reveal">
            <div>
              <div class="eyebrow"><Zap size={14} aria-hidden="true" /> {t.features.eyebrow}</div>
              <h2>{t.features.titleLine1}<br />{t.features.titleLine2}</h2>
            </div>
            <p>{t.features.lead}</p>
          </div>

          <div class="bento-grid">
            <article class="feature-card feature-large feature-multi reveal">
              <div class="feature-icon"><Layers size={22} /></div>
              <div class="feature-copy">
                <span class="feature-kicker">{t.features.multiKicker}</span>
                <h3>{t.features.multiTitleLine1}<br />{t.features.multiTitleLine2}</h3>
                <p>{t.features.multiBody}</p>
              </div>
              <div class="tunnel-visual" aria-hidden="true">
                <div class="tunnel-control">
                  <img src="/icon.svg" alt="" width="42" height="42" />
                  <div><strong>TunnelYard</strong><small>{t.features.multiSimultaneous}</small></div>
                  <span class="control-count"><i></i><i></i><i></i> 3/3</span>
                  <i class="hub-port port-one"></i>
                  <i class="hub-port port-two"></i>
                  <i class="hub-port port-three"></i>
                </div>
                <div class="tunnel-lanes">
                  <div class="tunnel-lane lane-one">
                    <span class="lane-wire"><i></i></span>
                    <div class="tunnel-endpoint endpoint-hq"><span>HQ</span><div><strong>Acme HQ</strong><small>42 ms</small></div><i></i></div>
                  </div>
                  <div class="tunnel-lane lane-two">
                    <span class="lane-wire"><i></i></span>
                    <div class="tunnel-endpoint endpoint-nx"><span>NX</span><div><strong>North</strong><small>68 ms</small></div><i></i></div>
                  </div>
                  <div class="tunnel-lane lane-three">
                    <span class="lane-wire"><i></i></span>
                    <div class="tunnel-endpoint endpoint-st"><span>ST</span><div><strong>Staging</strong><small>31 ms</small></div><i></i></div>
                  </div>
                </div>
              </div>
            </article>

            <article class="feature-card feature-editor reveal reveal-delay-1">
              <div class="feature-icon"><FilePenLine size={21} /></div>
              <span class="feature-kicker">{t.features.profilesKicker}</span>
              <h3>{t.features.profilesTitle}</h3>
              <p>{t.features.profilesBody}</p>
              <div class="editor-preview" aria-hidden="true">
                <div><span>{t.features.profilesGateway}</span><strong>vpn.acme.com</strong></div>
                <div><span>{t.features.profilesPort}</span><strong>10443</strong></div>
                <div class="editor-switch"><span>{t.features.profilesReconnect}</span><i></i></div>
              </div>
            </article>

            <article class="feature-card feature-alerts reveal">
              <div class="feature-icon"><BellRing size={21} /></div>
              <span class="feature-kicker">{t.features.alertsKicker}</span>
              <h3>{t.features.alertsTitle}</h3>
              <p>{t.features.alertsBody}</p>
              <div class="alert-stack" aria-hidden="true">
                <div><CircleCheck size={17} /><span><strong>{t.features.alertsConnected}</strong><small>{t.features.alertsNow}</small></span></div>
                <div><RefreshCw size={17} /><span><strong>{t.features.alertsRecovered}</strong><small>{t.features.alertsAgo}</small></span></div>
              </div>
            </article>

            <article class="feature-card feature-tray reveal reveal-delay-1">
              <div class="feature-icon"><Network size={21} /></div>
              <span class="feature-kicker">{t.features.trayKicker}</span>
              <h3>{t.features.trayTitleLine1}<br />{t.features.trayTitleLine2}</h3>
              <p>{t.features.trayBody}</p>
              <div class="tray-preview" aria-hidden="true">
                <div class="tray-bar"><span></span><span></span><span></span><div class="tray-icon"><img src="/icon.svg" alt="" /></div></div>
                <div class="tray-menu">
                  <strong>TunnelYard</strong>
                  <span><i></i> Acme HQ <small>{t.features.trayConnected}</small></span>
                  <span><i></i> {t.hero.app.northClient} <small>{t.features.trayConnected}</small></span>
                </div>
              </div>
            </article>

            <article class="feature-card feature-language reveal">
              <div class="feature-icon"><Globe size={21} /></div>
              <span class="feature-kicker">{t.features.languageKicker}</span>
              <h3>{t.features.languageTitle}</h3>
              <p>{t.features.languageBody}</p>
              <div class="language-pills" aria-hidden="true"><span class={locale === "pt-BR" ? "active" : undefined}>PT-BR</span><span class={locale === "en" ? "active" : undefined}>EN</span><i></i></div>
            </article>
          </div>
        </div>
      </section>

      <section class="security section" id="seguranca">
        <div class="security-glow" aria-hidden="true"></div>
        <div class="container security-grid">
          <div class="security-copy reveal">
            <div class="eyebrow eyebrow-dark"><LockKeyhole size={14} aria-hidden="true" /> {t.security.eyebrow}</div>
            <h2>{t.security.title}</h2>
            <p>{t.security.body}</p>
            <a href={repoUrl + "#privacy-notes"} target="_blank" rel="noreferrer">
              {t.security.link}
              <ExternalLink size={15} />
            </a>
          </div>

          <div class="security-steps reveal reveal-delay-2">
            <div class="security-step">
              <span class="step-number">01</span>
              <div class="step-icon"><Monitor size={19} /></div>
              <div><strong>{t.security.stepOneTitle}</strong><p>{t.security.stepOneBody}</p></div>
            </div>
            <div class="step-connector"></div>
            <div class="security-step">
              <span class="step-number">02</span>
              <div class="step-icon"><ShieldCheck size={19} /></div>
              <div><strong>{t.security.stepTwoTitle}</strong><p>{t.security.stepTwoBody}</p></div>
            </div>
            <div class="step-connector"></div>
            <div class="security-step">
              <span class="step-number">03</span>
              <div class="step-icon"><LockKeyhole size={19} /></div>
              <div><strong>{t.security.stepThreeTitle}</strong><p>{t.security.stepThreeBody}</p></div>
            </div>
          </div>
        </div>
      </section>

      <MemoryLab locale={locale} t={t} />

      <section class="downloads section" id="downloads">
        <div class="container">
          <div class="section-heading centered reveal">
            <div class="eyebrow"><Download size={14} aria-hidden="true" /> {fill(t.downloads.eyebrow, { version })}</div>
            <h2>{t.downloads.title}</h2>
            <p>{t.downloads.lead}</p>
          </div>

          <Downloads t={t} />

          <p class="download-note reveal">
            {t.downloads.note}
            <a href={releaseUrl}>{t.downloads.noteLink}</a>
          </p>
        </div>
      </section>

      <section class="final-cta section">
        <div class="container">
          <div class="cta-panel reveal">
            <div class="cta-grid" aria-hidden="true"></div>
            <div class="cta-orb cta-orb-one" aria-hidden="true"></div>
            <div class="cta-orb cta-orb-two" aria-hidden="true"></div>
            <img src="/icon.svg" alt="" width="72" height="72" class="cta-icon" />
            <div class="eyebrow eyebrow-light"><Sparkles size={14} /> {t.cta.eyebrow}</div>
            <h2>{t.cta.titleLine1}<br />{t.cta.titleLine2}</h2>
            <p>{t.cta.body}</p>
            <div class="cta-actions">
              <a class="button button-white button-large" href="#downloads"><Download size={19} /> {fill(t.cta.download, { version })}</a>
              <a class="button button-ghost-light button-large" href={repoUrl} target="_blank" rel="noreferrer"><BrandIcon name="simple-icons:github" size={19} /> {t.cta.github}</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <div class="footer-brand">
          <a class="brand" href="#inicio"><img src="/icon.svg" alt="" width="34" height="34" /><span>TunnelYard</span></a>
          <p>{t.footer.tagline}</p>
        </div>
        <div class="footer-links">
          <a href={repoUrl} target="_blank" rel="noreferrer">{t.footer.github}</a>
          <a href={releaseUrl}>{t.footer.releases}</a>
          <a href={repoUrl + "/blob/master/LICENSE"} target="_blank" rel="noreferrer">{t.footer.license}</a>
          <a href={repoUrl + "/issues"} target="_blank" rel="noreferrer">{t.footer.issues}</a>
        </div>
        <p class="footer-meta">{t.footer.meta}</p>
      </div>
    </footer>

    <script>
      const header = document.querySelector<HTMLElement>("[data-header]");
      const menuButton = document.querySelector<HTMLButtonElement>("[data-menu-button]");
      const mobileNav = document.querySelector<HTMLElement>("[data-mobile-nav]");

      const closeMenu = () => {
        menuButton?.setAttribute("aria-expanded", "false");
        header?.classList.remove("menu-is-open");
      };

      menuButton?.addEventListener("click", () => {
        const nextState = menuButton.getAttribute("aria-expanded") !== "true";
        menuButton.setAttribute("aria-expanded", String(nextState));
        header?.classList.toggle("menu-is-open", nextState);
      });

      mobileNav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));

      const updateHeader = () => header?.classList.toggle("is-scrolled", window.scrollY > 18);
      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });

      const download = document.querySelector<HTMLAnchorElement>("[data-primary-download]");
      const downloadLabel = document.querySelector<HTMLElement>("[data-download-label]");
      const userAgent = navigator.userAgent.toLowerCase();

      if (download && downloadLabel) {
        // Labels come from data attributes so this stays language-agnostic.
        if (userAgent.includes("mac")) {
          download.href = "#download-macos";
          downloadLabel.textContent = download.dataset.labelMac!;
        } else if (userAgent.includes("win")) {
          download.href = "#download-windows";
          downloadLabel.textContent = download.dataset.labelWindows!;
        } else if (userAgent.includes("linux")) {
          download.href = "#download-linux";
          downloadLabel.textContent = download.dataset.labelLinux!;
        }
      }

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const revealItems = document.querySelectorAll<HTMLElement>(".reveal");

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -48px" }
        );
        revealItems.forEach((item) => observer.observe(item));
      }

      const hero = document.querySelector<HTMLElement>(".hero");
      hero?.addEventListener("pointermove", (event) => {
        if (reduceMotion) return;
        const bounds = hero.getBoundingClientRect();
        hero.style.setProperty("--pointer-x", String(event.clientX - bounds.left) + "px");
        hero.style.setProperty("--pointer-y", String(event.clientY - bounds.top) + "px");
      });
    </script>
  </body>
</html>
