---
import { Download } from "@lucide/astro";
import { Icon } from "astro-icon/components";
import { release } from "../data/release";
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;

const platforms = [
  {
    id: "linux",
    name: t.downloads.linuxName,
    icon: "linux",
    description: t.downloads.linuxDescription,
    pickerLabel: t.downloads.pickerProcessorAndPackage,
    choices: [
      [t.downloads.choiceDebX64, "_amd64.deb"],
      [t.downloads.choiceDebArm, "_arm64.deb"],
      [t.downloads.choiceRpmX64, ".x86_64.rpm"],
      [t.downloads.choiceRpmArm, ".aarch64.rpm"],
      [t.downloads.choiceTarX64, "-linux-x64.tar.gz"],
      [t.downloads.choiceTarArm, "-linux-arm64.tar.gz"],
    ],
  },
  {
    id: "macos",
    name: t.downloads.macosName,
    icon: "apple",
    description: t.downloads.macosDescription,
    pickerLabel: t.downloads.pickerProcessor,
    choices: [
      [t.downloads.choiceMacSilicon, "-macos.dmg"],
      [t.downloads.choiceMacIntel, "-macos.dmg"],
    ],
  },
  {
    id: "windows",
    name: t.downloads.windowsName,
    icon: "windows",
    description: t.downloads.windowsDescription,
    pickerLabel: t.downloads.pickerProcessor,
    choices: [
      [t.downloads.choiceWinX64, "-windows-x64.exe"],
      [t.downloads.choiceWinArm, "-windows-arm64.exe"],
    ],
  },
];

const assetFor = (suffix: string) => {
  const asset = release.assets.find(asset => asset.name.endsWith(suffix));
  if (!asset) throw new Error(`Installer missing from the release: ${suffix}`);
  return asset;
};
---
<div class="platform-grid">
  {platforms.map(platform => (
    <article class="platform-card reveal" id={`download-${platform.id}`} data-download-card>
      <div class="platform-top"><span class="platform-icon"><Icon name={`simple-icons:${platform.icon}`} size={28} /></span><span class="arch-pill">{release.tag_name}</span></div>
      <h3>{platform.name}</h3>
      <p>{platform.description}</p>
      <label class="download-picker" for={`build-${platform.id}`}>
        {platform.pickerLabel}
        <select id={`build-${platform.id}`} data-build-picker>
          <option value="">{t.downloads.pickerPlaceholder}</option>
          {platform.choices.map(([label, suffix]) => (
            <option value={assetFor(suffix).browser_download_url}>{label}</option>
          ))}
        </select>
      </label>
      <a
        class="button button-primary button-platform"
        data-file-download
        data-label-idle={t.downloads.buttonIdle}
        data-label-ready={t.downloads.buttonReady}
        data-file-hint={t.downloads.fileHint}
        aria-disabled="true"
        tabindex="-1"
      ><Download size={17} /> <span>{t.downloads.buttonIdle}</span></a>
      <p class="download-file" data-file-name aria-live="polite">{t.downloads.fileHint}</p>
      <noscript><ul class="download-fallback">{platform.choices.map(([label, suffix]) => <li><a href={assetFor(suffix).browser_download_url}>{label}</a></li>)}</ul></noscript>
    </article>
  ))}
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-download-card]").forEach(card => {
    const picker = card.querySelector<HTMLSelectElement>("[data-build-picker]")!;
    const link = card.querySelector<HTMLAnchorElement>("[data-file-download]")!;
    // Labels ride along in data attributes so this script stays language-agnostic.
    const labelIdle = link.dataset.labelIdle!;
    const labelReady = link.dataset.labelReady!;
    const fileHint = link.dataset.fileHint!;
    const update = () => {
      if (picker.value) {
        link.href = picker.value;
        link.removeAttribute("aria-disabled");
        link.removeAttribute("tabindex");
      } else {
        link.removeAttribute("href");
        link.setAttribute("aria-disabled", "true");
        link.tabIndex = -1;
      }
      link.querySelector("span")!.textContent = picker.value ? labelReady : labelIdle;
      card.querySelector("[data-file-name]")!.textContent = picker.value
        ? decodeURIComponent(picker.value.split("/").pop()!)
        : fileHint;
    };
    picker.addEventListener("change", update);
    update();
  });
</script>
