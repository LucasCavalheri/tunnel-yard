---
import { Download } from "@lucide/astro";
import { Icon } from "astro-icon/components";
import { release } from "../data/release";
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;

const families = [
  {
    id: "deb",
    label: t.downloads.familyDeb,
    pack: t.downloads.packageDeb,
    distros: [
      ["debian", "Debian"],
      ["ubuntu", "Ubuntu"],
      ["linuxmint", "Linux Mint"],
      ["popos", "Pop!_OS"],
      ["kalilinux", "Kali"],
      ["elementary", "elementary"],
      ["raspberrypi", "Raspberry Pi OS"],
      ["zorin", "Zorin"],
    ],
  },
  {
    id: "rpm",
    label: t.downloads.familyRpm,
    pack: t.downloads.packageRpm,
    distros: [
      ["fedora", "Fedora"],
      ["redhat", "RHEL"],
      ["rockylinux", "Rocky"],
      ["almalinux", "AlmaLinux"],
      ["opensuse", "openSUSE"],
    ],
  },
  {
    id: "arch",
    label: t.downloads.familyArch,
    pack: t.downloads.packageArch,
    distros: [
      ["archlinux", "Arch"],
      ["manjaro", "Manjaro"],
    ],
  },
  {
    id: "apk",
    label: t.downloads.familyApk,
    pack: t.downloads.packageApk,
    distros: [["alpinelinux", "Alpine"]],
  },
  {
    id: "tar",
    label: t.downloads.familyTar,
    pack: t.downloads.packageTar,
    distros: [
      ["gentoo", "Gentoo"],
      ["voidlinux", "Void"],
      ["nixos", "NixOS"],
      ["linux", t.downloads.otherLinux],
    ],
  },
] as const;

const assetFor = (...suffixes: string[]) => {
  for (const suffix of suffixes) {
    const asset = release.assets.find(asset => asset.name.endsWith(suffix));
    if (asset) return asset;
  }
  throw new Error(`Installer missing from the release: ${suffixes.join(" / ")}`);
};

const files = [
  [t.downloads.choiceDebX64, "_amd64.deb"],
  [t.downloads.choiceDebArm, "_arm64.deb"],
  [t.downloads.choiceRpmX64, ".x86_64.rpm"],
  [t.downloads.choiceRpmArm, ".aarch64.rpm"],
  [t.downloads.choiceArchX64, "-x86_64.pkg.tar.zst"],
  [t.downloads.choiceArchArm, "-aarch64.pkg.tar.zst"],
  [t.downloads.choiceApkX64, "-x86_64.apk"],
  [t.downloads.choiceApkArm, "-aarch64.apk"],
  [t.downloads.choiceTarX64, "-linux-x64.tar.gz"],
  [t.downloads.choiceTarArm, "-linux-arm64.tar.gz"],
] as const;

const optionalFiles = files.filter(([, suffix]) =>
  release.assets.some(asset => asset.name.endsWith(suffix))
);
---
<article
  class="linux-board reveal"
  id="download-linux"
  data-download-board
  data-download-card
  data-url-deb-x64={assetFor("_amd64.deb").browser_download_url}
  data-url-deb-arm64={assetFor("_arm64.deb").browser_download_url}
  data-url-rpm-x64={assetFor(".x86_64.rpm").browser_download_url}
  data-url-rpm-arm64={assetFor(".aarch64.rpm").browser_download_url}
  data-url-arch-x64={assetFor("-x86_64.pkg.tar.zst", "-linux-x64.tar.gz").browser_download_url}
  data-url-arch-arm64={assetFor("-aarch64.pkg.tar.zst", "-linux-arm64.tar.gz").browser_download_url}
  data-url-apk-x64={assetFor("-x86_64.apk", "-linux-x64.tar.gz").browser_download_url}
  data-url-apk-arm64={assetFor("-aarch64.apk", "-linux-arm64.tar.gz").browser_download_url}
  data-url-tar-x64={assetFor("-linux-x64.tar.gz").browser_download_url}
  data-url-tar-arm64={assetFor("-linux-arm64.tar.gz").browser_download_url}
  data-pick-hint={t.downloads.pickHint}
  data-pick-arch-hint={t.downloads.pickArchHint}
  data-pick-distro-hint={t.downloads.pickDistroHint}
  data-selected-hint={t.downloads.selectedHint}
>
  <div class="linux-board-top">
    <p class="linux-board-kicker">{t.downloads.pickArch}</p>
    <span class="arch-pill">{release.tag_name}</span>
  </div>

  <p class="cpu-warning">{t.downloads.archWarning}</p>
  <div class="cpu-pick" role="radiogroup" aria-label={t.downloads.pickArch}>
    <button type="button" class="cpu-card" role="radio" aria-checked="false" data-arch="x64">
      <span class="cpu-card-kicker">{t.downloads.archX64Kicker}</span>
      <strong>{t.downloads.archX64Title}</strong>
      <span>{t.downloads.archX64Help}</span>
    </button>
    <button type="button" class="cpu-card" role="radio" aria-checked="false" data-arch="arm64">
      <span class="cpu-card-kicker">{t.downloads.archArm64Kicker}</span>
      <strong>{t.downloads.archArm64Title}</strong>
      <span>{t.downloads.archArm64Help}</span>
    </button>
  </div>

  <p class="linux-board-kicker distro-kicker">{t.downloads.pickDistro}</p>
  {families.map(family => (
    <div class="distro-family">
      <p class="distro-family-label">{family.label}</p>
      <div class="distro-galaxy" role="radiogroup" aria-label={family.label}>
        {family.distros.map(([icon, name]) => (
          <button
            type="button"
            class="distro-tile"
            role="radio"
            aria-checked="false"
            data-distro
            data-family={family.id}
            data-name={name}
            data-pack={family.pack}
          >
            <span class="distro-glyph" aria-hidden="true">
              <Icon name={`simple-icons:${icon}`} size={28} />
            </span>
            <span class="distro-name">{name}</span>
          </button>
        ))}
      </div>
    </div>
  ))}

  <div class="linux-dock">
    <div class="linux-cta">
      <p class="linux-status" data-distro-status aria-live="polite">{t.downloads.pickHint}</p>
      <p class="download-file" data-file-name>{t.downloads.fileHint}</p>
    </div>
    <a
      class="button button-primary button-download"
      data-file-download
      data-label-idle={t.downloads.buttonIdle}
      data-label-ready={t.downloads.buttonReady}
      data-file-hint={t.downloads.fileHint}
      aria-disabled="true"
      tabindex="-1"
    ><Download size={17} /> <span>{t.downloads.buttonIdle}</span></a>
  </div>

  <noscript>
    <ul class="download-fallback">
      {optionalFiles.map(([label, suffix]) => {
        const asset = release.assets.find(item => item.name.endsWith(suffix));
        return asset ? <li><a href={asset.browser_download_url}>{label}</a></li> : null;
      })}
    </ul>
  </noscript>
</article>
<script>
  import { bindDownloadBoard } from "../download-board.js";

  let bootedPath = "";
  const bootDownloads = () => {
    if (bootedPath === location.pathname) return;
    bootedPath = location.pathname;
    bindDownloadBoard(document);
  };
  bootDownloads();
  document.addEventListener("astro:page-load", bootDownloads);
</script>
