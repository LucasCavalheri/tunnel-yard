---
import { ChevronDown, Download } from "@lucide/astro";
import { Icon } from "astro-icon/components";
import { release } from "../data/release";
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;

const platforms = [
  {
    id: "linux",
    name: t.downloads.linuxName,
    icon: "linux",
    description: t.downloads.linuxDescription,
    pickerLabel: t.downloads.pickerProcessorAndPackage,
    choices: [
      [t.downloads.choiceDebX64, "_amd64.deb"],
      [t.downloads.choiceDebArm, "_arm64.deb"],
      [t.downloads.choiceRpmX64, ".x86_64.rpm"],
      [t.downloads.choiceRpmArm, ".aarch64.rpm"],
      [t.downloads.choiceTarX64, "-linux-x64.tar.gz"],
      [t.downloads.choiceTarArm, "-linux-arm64.tar.gz"],
    ],
  },
];

const assetFor = (suffix: string) => {
  const asset = release.assets.find(asset => asset.name.endsWith(suffix));
  if (!asset) throw new Error(`Installer missing from the release: ${suffix}`);
  return asset;
};
---
<div class="platform-grid">
  {platforms.map(platform => (
    <article class="platform-card reveal" id={`download-${platform.id}`} data-download-card>
      <div class="platform-top"><span class="platform-icon"><Icon name={`simple-icons:${platform.icon}`} size={28} /></span><span class="arch-pill">{release.tag_name}</span></div>
      <h3>{platform.name}</h3>
      <p>{platform.description}</p>
      <div class="download-picker">
        <span class="picker-label" id={`build-${platform.id}-label`}>{platform.pickerLabel}</span>
        <div class="picker" data-download-picker>
          <button
            type="button"
            class="picker-trigger"
            id={`build-${platform.id}`}
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-controls={`build-${platform.id}-list`}
            aria-labelledby={`build-${platform.id}-label build-${platform.id}-value`}
          >
            <span id={`build-${platform.id}-value`} data-picker-label>{t.downloads.pickerPlaceholder}</span>
            <ChevronDown size={16} aria-hidden="true" />
          </button>
          <ul
            class="picker-menu"
            id={`build-${platform.id}-list`}
            role="listbox"
            aria-labelledby={`build-${platform.id}-label`}
            hidden
          >
            {platform.choices.map(([label, suffix]) => (
              <li role="option" data-value={assetFor(suffix).browser_download_url} aria-selected="false">{label}</li>
            ))}
          </ul>
        </div>
      </div>
      <a
        class="button button-primary button-platform"
        data-file-download
        data-label-idle={t.downloads.buttonIdle}
        data-label-ready={t.downloads.buttonReady}
        data-file-hint={t.downloads.fileHint}
        aria-disabled="true"
        tabindex="-1"
      ><Download size={17} /> <span>{t.downloads.buttonIdle}</span></a>
      <p class="download-file" data-file-name aria-live="polite">{t.downloads.fileHint}</p>
      <noscript><ul class="download-fallback">{platform.choices.map(([label, suffix]) => <li><a href={assetFor(suffix).browser_download_url}>{label}</a></li>)}</ul></noscript>
    </article>
  ))}
</div>
<script>
  import { bindDownloadPickers, closeDownloadPickersOnOutside } from "../download-picker.js";

  let bootedPath = "";
  const bootDownloads = () => {
    if (bootedPath === location.pathname) return;
    bootedPath = location.pathname;
    bindDownloadPickers(document);
  };
  bootDownloads();
  document.addEventListener("astro:page-load", bootDownloads);
  document.addEventListener("pointerdown", (event) => closeDownloadPickersOnOutside(event));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeDownloadPickersOnOutside({ target: document.body });
  });
</script>
