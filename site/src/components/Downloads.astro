---
import { Download } from "@lucide/astro";
import { Icon } from "astro-icon/components";
import { release } from "../data/release";

const platforms = [
  { id: "linux", name: "Linux", icon: "linux", description: "Debian, Ubuntu, Fedora, RHEL e outras distribuições.", choices: [
    ["Intel / AMD · x64 · Debian / Ubuntu (.deb)", "_amd64.deb"],
    ["ARM64 · Debian / Ubuntu (.deb)", "_arm64.deb"],
    ["Intel / AMD · x64 · Fedora / RHEL (.rpm)", ".x86_64.rpm"],
    ["ARM64 · Fedora / RHEL (.rpm)", ".aarch64.rpm"],
    ["Intel / AMD · x64 · Portátil (.tar.gz)", "-linux-x64.tar.gz"],
    ["ARM64 · Portátil (.tar.gz)", "-linux-arm64.tar.gz"],
  ] },
  { id: "macos", name: "macOS", icon: "apple", description: "Um único instalador universal. Escolha o chip do seu Mac: ambos usam o mesmo arquivo.", choices: [
    ["Apple Silicon · M1 ou posterior (.dmg)", "-macos.dmg"],
    ["Intel (.dmg)", "-macos.dmg"],
  ] },
  { id: "windows", name: "Windows", icon: "windows", description: "Escolha o processador do seu PC. AMD e Intel usam a versão x64.", choices: [
    ["Intel / AMD · x64 (.exe)", "-windows-x64.exe"],
    ["ARM64 · Snapdragon (.exe)", "-windows-arm64.exe"],
  ] },
];
---
<div class="platform-grid">
  {platforms.map(platform => (
    <article class="platform-card reveal" id={`download-${platform.id}`} data-download-card>
      <div class="platform-top"><span class="platform-icon"><Icon name={`simple-icons:${platform.icon}`} size={28} /></span><span class="arch-pill">{release.tag_name}</span></div>
      <h3>{platform.name}</h3>
      <p>{platform.description}</p>
      <label class="download-picker" for={`build-${platform.id}`}>
        Processador{platform.id === "linux" ? " e pacote" : ""}
        <select id={`build-${platform.id}`} data-build-picker>
          <option value="">Selecione uma opção</option>
          {platform.choices.map(([label, suffix]) => {
            const asset = release.assets.find(asset => asset.name.endsWith(suffix));
            if (!asset) throw new Error(`Instalador ausente na release: ${suffix}`);
            return <option value={asset.browser_download_url}>{label}</option>;
          })}
        </select>
      </label>
      <a class="button button-primary button-platform" data-file-download aria-disabled="true" tabindex="-1"><Download size={17} /> <span>Escolha o processador</span></a>
      <p class="download-file" data-file-name aria-live="polite">O arquivo será baixado diretamente do GitHub.</p>
      <noscript><ul class="download-fallback">{platform.choices.map(([label, suffix]) => <li><a href={release.assets.find(asset => asset.name.endsWith(suffix))!.browser_download_url}>{label}</a></li>)}</ul></noscript>
    </article>
  ))}
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-download-card]").forEach(card => {
    const picker = card.querySelector<HTMLSelectElement>("[data-build-picker]")!;
    const link = card.querySelector<HTMLAnchorElement>("[data-file-download]")!;
    const update = () => {
      if (picker.value) {
        link.href = picker.value;
        link.removeAttribute("aria-disabled");
        link.removeAttribute("tabindex");
      } else {
        link.removeAttribute("href");
        link.setAttribute("aria-disabled", "true");
        link.tabIndex = -1;
      }
      link.querySelector("span")!.textContent = picker.value ? "Baixar instalador" : "Escolha o processador";
      card.querySelector("[data-file-name]")!.textContent = picker.value ? decodeURIComponent(picker.value.split("/").pop()!) : "O arquivo será baixado diretamente do GitHub.";
    };
    picker.addEventListener("change", update);
    update();
  });
</script>
